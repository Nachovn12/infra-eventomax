# TEMPLATE ONLY. Copy to .env.prod (ignored); supply fresh private values.
RABBITMQ_ERLANG_COOKIE=<CHANGE_ME_RANDOM_ALPHANUMERIC_COOKIE>
RABBITMQ_DEFAULT_USER=eventomax_admin
RABBITMQ_DEFAULT_PASS=<CHANGE_ME_STRONG_ADMIN_PASS>

# Shared network for every application Compose: external eventomax-net.
SPRING_RABBITMQ_ADDRESSES=rabbitmq-1:5672,rabbitmq-2:5672
SPRING_RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_HOST=rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=eventomax_app
RABBITMQ_PASSWORD=<CHANGE_ME_STRONG_APP_PASS>

# Kafka UI login (served publicly at /kafka-ui behind edge proxy + API Gateway)
KAFKA_UI_USER=eventomax_admin
KAFKA_UI_PASSWORD=<CHANGE_ME_STRONG_KAFKA_UI_PASS>

# Edge Reverse Proxy (unifies BFF/Swagger, Kafka UI, and RabbitMQ UI under port 8080)
EDGE_PROXY_PORT=8080
BFF_UPSTREAM=ms-eventomax-bff:8080
KAFKA_UI_UPSTREAM=eventomax-kafka-ui:8080
RABBITMQ_MGMT_UPSTREAM=rabbitmq-1:15672

# Microsoft Entra ID & Kafka (required by rabbit-admin and kafka-admin)
ENTRA_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
ENTRA_AUDIENCE=api://<BACKEND_API_CLIENT_ID>
KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29093,kafka-3:29094

# Microsoft Graph (READ-ONLY directory integration — DISABLED by default)
# Keep per-service credentials in each microservice's own ignored .env.prod file:
#   - ms-eventomax-audit/.env.prod (requires Application permission: User.Read.All)
#   - ms-eventomax-productions/.env.prod (requires Application permissions: User.Read.All, Application.Read.All)
# Toggle each service independently (global EVENTOMAX_GRAPH_ENABLED is ignored by Compose):
AUDIT_GRAPH_ENABLED=false
PRODUCTIONS_GRAPH_ENABLED=false
EVENTOMAX_GRAPH_TENANT_ID=<ENTRA_TENANT_ID>
EVENTOMAX_GRAPH_CLIENT_ID=<GRAPH_SERVICE_CLIENT_ID>
EVENTOMAX_GRAPH_CLIENT_SECRET=<CHANGE_ME_GRAPH_CLIENT_SECRET>
# Productions only (external organizer selector):
EVENTOMAX_GRAPH_SERVICE_PRINCIPAL_ID=<EVENTOMAX_API_SERVICE_PRINCIPAL_OID>
EVENTOMAX_GRAPH_ORGANIZER_ROLE_ID=<ORGANIZER_APP_ROLE_ID>
