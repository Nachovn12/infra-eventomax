# TEMPLATE ONLY. Copy to .env.prod (ignored); supply fresh private values.
RABBITMQ_ERLANG_COOKIE=<CHANGE_ME_RANDOM_ALPHANUMERIC_COOKIE>
RABBITMQ_DEFAULT_USER=eventomax_admin
RABBITMQ_DEFAULT_PASS=<CHANGE_ME_STRONG_ADMIN_PASS>

# Shared network for every application Compose: external eventomax-net.
SPRING_RABBITMQ_ADDRESSES=rabbitmq-1:5672,rabbitmq-2:5672
SPRING_RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_HOST=rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=eventomax_app
RABBITMQ_PASSWORD=<CHANGE_ME_STRONG_APP_PASS>
