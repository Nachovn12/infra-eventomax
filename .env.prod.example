# TEMPLATE ONLY. Copy to .env.prod (ignored); supply fresh private values.
# B6A does not create the network, start containers, or provision accounts.
RABBITMQ_ERLANG_COOKIE=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# IMPORTANT: boot-time definitions import does not provision the default user
# on a blank node. B6B must explicitly provision accounts and permissions.
# DEFAULT_PASS also does not rotate passwords in existing persistent volumes.

# Shared network for every future application Compose: external eventomax-net.
# Set these in the actual application container environment (Compose .env alone
# does not inject variables into containers).
SPRING_RABBITMQ_ADDRESSES=rabbitmq-1:5672,rabbitmq-2:5672
SPRING_RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_HOST=rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# Each service gets its own private credentials; Rabbit Admin uses a distinct
# demo.*-restricted user. Supply its existing Entra settings separately.
# Host Java processes keep their current local broker endpoint; these Docker
# DNS names are for containers attached to eventomax-net only.
